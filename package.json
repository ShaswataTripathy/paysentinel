{
  "name": "paysentinel",
  "version": "0.2.0",
  "description": "A guard between AI shopping agents and your PayPal: every agent payment is held, checked against your intent, then captured or voided.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "mcp": "node src/mcp.js",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "paysentinel-mcp": "src/mcp.js"
  }
}
