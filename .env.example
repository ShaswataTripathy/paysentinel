# Copy to .env and fill in. Leave a value empty to run that part in MOCK mode.

# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# 1 = show a one-click "sandbox test card" button (needs a US sandbox business account)
PAYPAL_CARD_DEMO=0

# Gemini free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

PORT=3000

# Key that signs evidence receipts (any long random string). Required when NODE_ENV=production.
RECEIPT_SECRET=

# Optional
# NODE_ENV=production      # refuses to start without RECEIPT_SECRET, hides stack traces in logs
# DATA_DIR=./data          # where decisions, shops and profiles are stored (seeded from ./data)
# METRICS_TOKEN=           # if set, /api/metrics needs "Authorization: Bearer <token>"
# LOG_LEVEL=silent         # silence info logs (errors are always logged)
# PAYPAL_TIMEOUT_MS=30000
# GEMINI_TIMEOUT_MS=25000
